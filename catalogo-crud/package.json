{
  "name": "catalogo-produtos-crud",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VidaMix Studio: catálogo e criação de artes comerciais.",
  "scripts": {
    "start": "node server.mjs",
    "start:production": "node server.mjs",
    "dev": "node --watch server.mjs",
    "check": "node scripts/check.mjs",
    "check:production": "node scripts/production-check.mjs",
    "check:pwa": "node scripts/pwa-deployment-check.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:catalogue": "node --test scripts/catalogue-loading.test.mjs scripts/catalogue-mobile.test.mjs scripts/product-images.test.mjs scripts/image-cache.test.mjs",
    "test:app-mobile": "node --test scripts/app-shell.test.mjs scripts/home-mobile.test.mjs scripts/barcode-*.test.mjs",
    "test:tour": "node --test scripts/tour-storage.test.mjs",
    "test:stories-layout": "node --test scripts/stories-auto-layout.test.mjs",
    "test:stories-prices": "node --test scripts/stories-price-input.test.mjs",
    "test:stories-video": "node --test scripts/stories-video-*.test.mjs",
    "test:stories-mobile": "node --test scripts/stories-mobile.test.mjs scripts/stories-gestures.test.mjs",
    "test:indoor": "node --test scripts/indoor-*.test.mjs",
    "test:pwa": "node --test scripts/pwa.test.mjs",
    "verify": "npm run check && npm run test:catalogue && npm run test:app-mobile && npm run test:tour && npm run test:stories-layout && npm run test:stories-prices && npm run test:stories-video && npm run test:stories-mobile && npm run test:indoor && npm run test:pwa && npm run test:smoke"
  },
  "engines": {
    "node": ">=22.13.0 <25",
    "npm": ">=10"
  }
}
