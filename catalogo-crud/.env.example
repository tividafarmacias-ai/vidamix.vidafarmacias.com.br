# Copie para .env apenas se ainda não houver um arquivo configurado.
# Este arquivo contém somente exemplos. Não versione credenciais reais.
# O servidor carrega .env automaticamente; variáveis do host têm prioridade.

NODE_ENV=development

# Base MySQL que contém a tabela cliente. Preencha os valores reais no .env.
DB_HOST=mysql.exemplo.interno
DB_PORT=3306
DB_NAME=base_de_usuarios
DB_USER=usuario_de_leitura
DB_PASSWORD=

# TLS com validação de certificado: true/false. Padrão false.
# Mantenha false se o servidor MySQL não oferecer TLS.
DB_SSL=false

# Origem pública opcional, sem caminho, query ou fragmento.
# Em produção, informe a URL HTTPS externa quando usar proxy.
# APP_ORIGIN=https://studio.exemplo.com

# Padrão true em NODE_ENV=production; false em desenvolvimento.
# Em produção use HTTPS e mantenha o cookie Secure.
# AUTH_COOKIE_SECURE=true

# Ative apenas se o Node aceitar conexões exclusivamente de proxy confiável
# que normalize X-Forwarded-Proto e X-Forwarded-For.
AUTH_TRUST_PROXY=false

# Porta local padrão 3333. No Plesk, PORT é fornecida pela hospedagem.
# PORT=3333

# Caminhos opcionais, relativos à pasta catalogo-crud ou absolutos.
# CATALOG_STORAGE_ROOT=./data
# CATALOG_DATABASE_PATH=./data/catalogo.sqlite
# CATALOG_SOURCE=../produtos.json
# MANIFEST_SOURCE=../imagens-produtos/manifesto-imagens.json
# IMAGES_ROOT=../imagens-produtos
# STORY_BACKGROUNDS_ROOT=./camas-stories
# FEED_BACKGROUNDS_ROOT=./camas-feed
# INDOOR_BACKGROUNDS_ROOT=./camas-indoor-h

# O login é sempre obrigatório. APP_AUTH_ENABLED e HTTP Basic não são usados.
