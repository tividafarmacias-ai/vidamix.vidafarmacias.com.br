# Este arquivo é apenas uma referência. O Node não lê .env automaticamente:
# em Plesk, cadastre as variáveis em Node.js > Custom Environment Variables.

# Desenvolvimento local
NODE_ENV=development
PORT=3333

# Armazenamento persistente (use caminhos absolutos no Plesk).
# CATALOG_STORAGE_ROOT=./data
# CATALOG_DATABASE_PATH=/caminho/privado/vidamix/catalogo.sqlite

# Necessários no primeiro boot quando o banco ainda não existir.
# CATALOG_SOURCE=/caminho/privado/vidamix/catalogo/produtos.json
# MANIFEST_SOURCE=/caminho/privado/vidamix/imagens/manifesto-imagens.json
# IMAGES_ROOT=/caminho/privado/vidamix/imagens
# STORY_BACKGROUNDS_ROOT=./camas-stories

# Em produção, APP_AUTH_ENABLED é verdadeiro por padrão e as duas credenciais
# são obrigatórias. Nunca versione os valores reais.
# APP_AUTH_ENABLED=true
# APP_AUTH_USERNAME=admin
# APP_AUTH_PASSWORD=troque-por-uma-senha-longa-e-unica

# Futuras integrações (não preencher nem versionar segredos neste arquivo).
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# ARTIFACT_STORAGE_BUCKET=
