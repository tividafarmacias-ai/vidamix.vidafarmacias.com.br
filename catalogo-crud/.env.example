# O Node não lê este arquivo automaticamente.
# No Plesk, cadastre estas variáveis em Node.js > Custom Environment Variables.

# Produção
NODE_ENV=production
APP_AUTH_ENABLED=true
APP_AUTH_USERNAME=administrador
APP_AUTH_PASSWORD=troque-por-uma-senha-longa-e-unica

# Com a estrutura atual, não é necessário declarar os caminhos abaixo.
# Eles já assumem, a partir de catalogo-crud/:
# CATALOG_DATABASE_PATH=./data/catalogo.sqlite
# CATALOG_SOURCE=../produtos.json
# MANIFEST_SOURCE=../imagens-produtos/manifesto-imagens.json
# IMAGES_ROOT=../imagens-produtos
# STORY_BACKGROUNDS_ROOT=./camas-stories

# Não declare PORT no Plesk: ele é informado automaticamente pelo painel.

# Futuras integrações: nunca versione valores reais.
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# ARTIFACT_STORAGE_BUCKET=